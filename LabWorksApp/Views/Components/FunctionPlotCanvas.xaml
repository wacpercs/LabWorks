<UserControl x:Class="LabWorksApp.Views.Components.FunctionPlotCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="600"
             ClipToBounds="True">
    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8">
        <Grid>
            <!-- Холст для векторной отрисовки графика, осей и маркеров -->
            <Canvas x:Name="PlotCanvas" ClipToBounds="True" Background="Transparent"
                    MouseMove="PlotCanvas_MouseMove" MouseLeave="PlotCanvas_MouseLeave" SizeChanged="PlotCanvas_SizeChanged" />

            <!-- Подсказка текущих координат курсора -->
            <Border x:Name="BorderCursorCoord" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="10,10,0,0" Background="#1E293B" CornerRadius="4" Padding="6,2" Opacity="0.9"
                    BorderBrush="#475569" BorderThickness="1" Visibility="Collapsed">
                <TextBlock x:Name="TxtCursorCoord" Text="x: 0, y: 0" FontSize="11" Foreground="#38BDF8" FontFamily="Consolas" />
            </Border>

            <!-- Кнопки управления масштабом графика -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Orientation="Horizontal">
                <Button Content="➕" Width="28" Height="28" Margin="0,0,4,0" Background="#1E293B" Foreground="White" BorderBrush="#334155"
                        ToolTip="Приблизить" Click="BtnZoomIn_Click" />
                <Button Content="➖" Width="28" Height="28" Margin="0,0,4,0" Background="#1E293B" Foreground="White" BorderBrush="#334155"
                        ToolTip="Отдалить" Click="BtnZoomOut_Click" />
                <Button Content="⟲ Авто" Height="28" Padding="6,0" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155"
                        ToolTip="Автоподбор масштаба под интервал [a, b]" Click="BtnFitView_Click" FontSize="11" FontWeight="SemiBold" />
            </StackPanel>

            <!-- Легенда графика -->
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10" Orientation="Horizontal">
                <Border Background="#1E293B" CornerRadius="4" Padding="8,3" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="12" Height="3" Fill="#38BDF8" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="f(x)" FontSize="10" Foreground="#CBD5E1" Margin="0,0,10,0" />

                        <Rectangle Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,4,0" RadiusX="4" RadiusY="4" />
                        <TextBlock Text="Минимум" FontSize="10" Foreground="#A7F3D0" Margin="0,0,10,0" />

                        <Rectangle Width="8" Height="8" Fill="#F59E0B" VerticalAlignment="Center" Margin="0,0,4,0" RadiusX="4" RadiusY="4" />
                        <TextBlock Text="Корень" FontSize="10" Foreground="#FDE68A" Margin="0,0,10,0" />

                        <Rectangle Width="12" Height="8" Fill="#1E3A8A" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Интервал [a, b]" FontSize="10" Foreground="#94A3B8" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
