<Window x:Class="LabWorksApp.Views.GoogleSheetsImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Импорт данных из Google Таблиц" Height="360" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F172A" Foreground="#F8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Загрузка данных из Google Таблицы" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,12" />

        <!-- Способ 1: Ссылка -->
        <TextBlock Grid.Row="1" Text="Способ 1: Вставьте ссылку на общедоступную таблицу (доступ: 'Все, у кого есть ссылка'):" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4" />
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtSheetUrl" Grid.Column="0" Height="32" VerticalContentAlignment="Center"
                     Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" Padding="8,4"
                     Text="https://docs.google.com/spreadsheets/d/..." />
            <Button Grid.Column="1" Content="Загрузить" Width="90" Height="32" Margin="8,0,0,0"
                    Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                    Click="BtnDownloadUrl_Click" />
        </Grid>

        <!-- Способ 2: Вставка из буфера -->
        <TextBlock Grid.Row="3" Text="Способ 2: Либо скопируйте ячейки из таблицы и вставьте сюда текст:" FontSize="12" Foreground="#CBD5E1" Margin="0,4,0,4" />
        <TextBox x:Name="TxtDirectData" Grid.Row="3" Margin="0,24,0,0"
                 Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6" />

        <!-- Статус ошибки/сообщения -->
        <TextBlock x:Name="TxtError" Grid.Row="4" Text="" Foreground="#F87171" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,8" Visibility="Collapsed" />

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Применить вставленный текст" Height="32" Padding="12,0" Margin="0,0,8,0"
                    Background="#059669" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                    Click="BtnApplyDirectText_Click" />
            <Button Content="Отмена" Height="32" Width="80"
                    Background="#334155" Foreground="#F8FAFC" BorderThickness="0"
                    Click="BtnCancel_Click" />
        </StackPanel>
    </Grid>
</Window>
