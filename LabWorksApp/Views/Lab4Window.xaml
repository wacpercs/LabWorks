<Window x:Class="LabWorksApp.Views.Lab4Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторная работа №4 — Алгоритмы сортировки данных" 
        Height="820" Width="1200" MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- WPF Menu (MenuStrip) -->
            <RowDefinition Height="Auto" /> <!-- Панель генерации и параметров -->
            <RowDefinition Height="*" />    <!-- Основная рабочая область: DataGrid слева, Визуализация справа -->
            <RowDefinition Height="Auto" /> <!-- Сводная таблица результатов (как на доске) -->
            <RowDefinition Height="Auto" /> <!-- Строка состояния -->
        </Grid.RowDefinitions>

        <!-- 1. MenuStrip (WPF Menu) -->
        <Menu Grid.Row="0" Background="#1E293B" Foreground="#F8FAFC" Padding="4,2" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <MenuItem Header="_Файл" Foreground="#F8FAFC">
                <MenuItem Header="Загрузить из _Excel (.xlsx, .csv)..." Click="MenuLoadExcel_Click" Foreground="#0F172A" />
                <MenuItem Header="Загрузить из _Google Таблицы..." Click="MenuLoadGoogleSheets_Click" Foreground="#0F172A" />
                <Separator />
                <MenuItem Header="Вставить массив из буфера обмена" Click="MenuPasteClipboard_Click" Foreground="#0F172A" />
                <Separator />
                <MenuItem Header="_Закрыть окно" Click="MenuClose_Click" Foreground="#0F172A" />
            </MenuItem>

            <MenuItem Header="_Действия" Foreground="#F8FAFC">
                <MenuItem Header="_Рассчитать / Запуск сортировки" Click="BtnStartSort_Click" Foreground="#0F172A" FontWeight="Bold" />
                <MenuItem Header="_Пауза / Продолжить" Click="BtnPauseResume_Click" Foreground="#0F172A" />
                <MenuItem Header="_Очистить" Click="BtnClear_Click" Foreground="#0F172A" />
                <Separator />
                <MenuItem Header="_Сгенерировать случайный массив" Click="BtnGenerateArray_Click" Foreground="#0F172A" />
            </MenuItem>

            <MenuItem Header="_Справка" Foreground="#F8FAFC">
                <MenuItem Header="Задание к лабораторной работе" Click="MenuHelpTask_Click" Foreground="#0F172A" />
                <MenuItem Header="О программе" Click="MenuHelpAbout_Click" Foreground="#0F172A" />
            </MenuItem>
        </Menu>

        <!-- 2. Панель параметров, генератора и выбора алгоритмов -->
        <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Генератор массива A, B, N -->
                    <ColumnDefinition Width="Auto" /> <!-- Разделитель -->
                    <ColumnDefinition Width="Auto" /> <!-- Тумблер направления -->
                    <ColumnDefinition Width="Auto" /> <!-- Разделитель -->
                    <ColumnDefinition Width="*" />    <!-- Чекбоксы алгоритмов -->
                </Grid.ColumnDefinitions>

                <!-- Генератор A, B, N -->
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,12,0">
                    <TextBlock Text="ГЕНЕРАТОР МАССИВА" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="A =" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" />
                        <TextBox x:Name="TxtRangeA" Width="45" Text="-50" ToolTip="Нижняя граница диапазона A" Margin="0,0,8,0" />

                        <TextBlock Text="B =" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" />
                        <TextBox x:Name="TxtRangeB" Width="45" Text="50" ToolTip="Верхняя граница диапазона B" Margin="0,0,8,0" />

                        <TextBlock Text="N =" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" />
                        <TextBox x:Name="TxtCountN" Width="45" Text="20" ToolTip="Количество элементов (макс. 50)" Margin="0,0,10,0" />

                        <Button Content="Сгенерировать" Background="#2563EB" Foreground="White" BorderThickness="0"
                                Padding="8,4" FontWeight="SemiBold" Click="BtnGenerateArray_Click" />
                    </StackPanel>
                    <TextBlock Text="* Ограничение: не более 50 элементов" FontSize="10" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Разделитель -->
                <Rectangle Grid.Column="1" Width="1" Fill="#334155" Margin="0,2,12,2" />

                <!-- Тумблер направления сортировки -->
                <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,12,0">
                    <TextBlock Text="НАПРАВЛЕНИЕ СОРТИРОВКИ" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" />
                    <StackPanel Orientation="Vertical">
                        <RadioButton x:Name="RadioAscending" GroupName="SortDirection" Content="По возрастанию (▲)" IsChecked="True" />
                        <RadioButton x:Name="RadioDescending" GroupName="SortDirection" Content="По убыванию (▼)" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Разделитель -->
                <Rectangle Grid.Column="3" Width="1" Fill="#334155" Margin="0,2,12,2" />

                <!-- Чекбоксы алгоритмов -->
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="ВЫБОР АЛГОРИТМОВ ДЛЯ ОДНОВРЕМЕННОЙ СОРТИРОВКИ" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                        <CheckBox x:Name="ChkSelectAll" Content="Выбрать все" FontWeight="Bold" Margin="16,0,0,0"
                                  Checked="ChkSelectAll_Checked" Unchecked="ChkSelectAll_Unchecked" />
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal">
                        <CheckBox x:Name="ChkBubble" Content="1. Пузырьковая (n - 1)" IsChecked="True" Margin="0,2,16,2" />
                        <CheckBox x:Name="ChkShaker" Content="2. Шейкерная ((n - 1) / 2)" IsChecked="True" Margin="0,2,16,2" />
                        <CheckBox x:Name="ChkInsertion" Content="3. Вставками" IsChecked="True" Margin="0,2,16,2" />
                        <CheckBox x:Name="ChkQuick" Content="4. Быстрая" IsChecked="True" Margin="0,2,16,2" />
                        
                        <!-- BOGO с окошком количества итераций -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                            <CheckBox x:Name="ChkBogo" Content="5. BOGO" IsChecked="False" VerticalAlignment="Center" />
                            <TextBlock Text="лимит итер.:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,4,0" />
                            <TextBox x:Name="TxtBogoLimit" Width="60" Text="10000" ToolTip="Лимит итераций для BOGO сортировки" VerticalContentAlignment="Center" />
                        </StackPanel>
                    </WrapPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Основная область: DataGrid массива (слева) + Визуализаторы (справа) -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="400" />
                <ColumnDefinition Width="Auto" /> <!-- Сплиттер -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: Ввод и просмотр данных через DataGrid -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="ВХОДНОЙ МАССИВ" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" />
                        <TextBlock Text="Редактируйте прямо в таблице или сгенерируйте" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>

                    <!-- DataGrid (эквивалент DataGridView из задания) -->
                    <DataGrid x:Name="GridArray" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True"
                              CanUserDeleteRows="True" Background="#0F172A" Foreground="#F8FAFC"
                              RowBackground="#1E293B" AlternatingRowBackground="#182234"
                              BorderBrush="#334155" GridLinesVisibility="All" HorizontalGridLinesBrush="#334155" VerticalGridLinesBrush="#334155"
                              HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Index}" IsReadOnly="True" Width="50" />
                            <DataGridTextColumn Header="Значение" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="0,6,0,0">
                        <TextBlock x:Name="TxtArrayCount" Text="Элементов: 0 / 50" FontSize="11" Foreground="#94A3B8" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Импорт Excel" Margin="0,0,6,0" Padding="6,2" FontSize="11" Background="#334155" Foreground="White" BorderThickness="0" Click="MenuLoadExcel_Click" />
                            <Button Content="Google Таблица" Padding="6,2" FontSize="11" Background="#334155" Foreground="White" BorderThickness="0" Click="MenuLoadGoogleSheets_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- Правая колонка: Панель визуализации выбранных алгоритмов -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Панель управления визуализацией -->
                        <RowDefinition Height="*" />    <!-- Сетка визуализаторов -->
                    </Grid.RowDefinitions>

                    <!-- Панель управления анимацией -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnStart" Content="▶ Рассчитать" Background="#10B981" Foreground="White"
                                    FontWeight="Bold" Padding="12,5" Margin="0,0,8,0" BorderThickness="0"
                                    Click="BtnStartSort_Click" />
                            <Button x:Name="BtnPause" Content="⏸ Пауза" Background="#475569" Foreground="White"
                                    Padding="10,5" Margin="0,0,8,0" BorderThickness="0" IsEnabled="False"
                                    Click="BtnPauseResume_Click" />
                            <Button x:Name="BtnClear" Content="⏹ Сбросить" Background="#334155" Foreground="#F8FAFC"
                                    Padding="10,5" Margin="0,0,8,0" BorderThickness="0"
                                    Click="BtnClear_Click" />
                        </StackPanel>

                        <!-- Скорость визуализации -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Скорость визуализации:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Slider x:Name="SliderSpeed" Width="120" Minimum="1" Maximum="100" Value="60" VerticalAlignment="Center"
                                    TickFrequency="10" IsSnapToTickEnabled="False" ValueChanged="SliderSpeed_ValueChanged" />
                            <TextBlock x:Name="TxtSpeedVal" Text="x1.0" Width="36" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Сетка с визуализаторами всех активных сортировок -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="PanelVisualizers" Orientation="Horizontal" ItemWidth="420" ItemHeight="230" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Сводная таблица результатов (как на доске преподавателя) -->
        <Border Grid.Row="3" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,1,0,1" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="СВОДНАЯ ТАБЛИЦА РЕЗУЛЬТАТОВ СОРТИРОВОК" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" />
                    <TextBlock x:Name="TxtFastestSummary" Grid.Column="1" Text="Самый быстрый метод: —" FontWeight="Bold" Foreground="#34D399" FontSize="12" />
                </Grid>

                <!-- Таблица по макету с доски: 1..5 столбцы, строки к/и и t -->
                <DataGrid x:Name="GridResults" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#0F172A" Foreground="#F8FAFC"
                          RowBackground="#1E293B" AlternatingRowBackground="#182234"
                          BorderBrush="#334155" GridLinesVisibility="All" HorizontalGridLinesBrush="#334155" VerticalGridLinesBrush="#334155"
                          HeadersVisibility="Column" SelectionMode="Single" Height="90">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Параметр" Binding="{Binding MetricName}" FontWeight="Bold" Width="100" />
                        <DataGridTextColumn Header="1. Пузырьковая" Binding="{Binding Bubble}" Width="*" />
                        <DataGridTextColumn Header="2. Шейкерная" Binding="{Binding Shaker}" Width="*" />
                        <DataGridTextColumn Header="3. Вставками" Binding="{Binding Insertion}" Width="*" />
                        <DataGridTextColumn Header="4. Быстрая" Binding="{Binding Quick}" Width="*" />
                        <DataGridTextColumn Header="5. BOGO" Binding="{Binding Bogo}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" Text="* Время t измерено прямым бенчмарком без учета накладных расходов анимации." FontSize="10" Foreground="#64748B" Margin="0,4,0,0" />
            </Grid>
        </Border>

        <!-- 5. Строка состояния -->
        <StatusBar Grid.Row="4" Background="#0F172A" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="4,2">
            <StatusBarItem>
                <TextBlock x:Name="StatusMessage" Text="Готово к работе. Задайте массив или нажмите 'Сгенерировать'." FontSize="11" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
