<Window x:Class="LabWorksApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторные работы — Главное меню" 
        Height="620" Width="880" MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Заголовок -->
            <RowDefinition Height="Auto" /> <!-- Быстрый выбор через выпадающий список -->
            <RowDefinition Height="*" />    <!-- Сетка карточек лабораторных -->
            <RowDefinition Height="Auto" /> <!-- Подвал -->
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="СИСТЕМА ЛАБОРАТОРНЫХ РАБОТ" FontSize="22" FontWeight="ExtraBold" Foreground="#38BDF8" />
            <TextBlock Text="Выберите номер лабораторной работы для перехода к расчётам и визуализации" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Быстрый выбор по номеру -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="14,10" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Быстрый выбор лабораторной:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                
                <ComboBox Grid.Column="1" x:Name="ComboLabSelect" Width="280" Height="32" VerticalContentAlignment="Center"
                          Background="#0F172A" Foreground="#0F172A" SelectedIndex="3">
                    <ComboBoxItem Content="Лабораторная работа №1: Численные методы (Дихотомия)" FontWeight="Bold" />
                    <ComboBoxItem Content="Лабораторная работа №2 (В разработке)" />
                    <ComboBoxItem Content="Лабораторная работа №3 (В разработке)" />
                    <ComboBoxItem Content="Лабораторная работа №4: Алгоритмы сортировки" FontWeight="Bold" />
                    <ComboBoxItem Content="Лабораторная работа №5 (В разработке)" />
                </ComboBox>

                <Button Grid.Column="3" Content="Открыть выбранную работу ▶" Height="32" Padding="16,0"
                        Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold"
                        Click="BtnOpenSelectedLab_Click" />
            </Grid>
        </Border>

        <!-- Сетка карточек лабораторных работ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <UniformGrid Columns="2" Margin="-6">
                <!-- Карточка Лаб 1 (АКТИВНАЯ) -->
                <Border Background="#1E293B" CornerRadius="8" BorderBrush="#0284C7" BorderThickness="2" Padding="16" Margin="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="Лабораторная работа №1" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" />
                            <Border Background="#065F46" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock Text="ГОТОВА К РАБОТЕ" FontSize="10" FontWeight="Bold" Foreground="#6EE7B7" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Поиск локального минимума функции f(x) и корней на интервале [a, b] методом половинного деления (дихотомии). Интерактивный векторный график, масштабирование, протокол итераций в DataGrid."
                                   FontSize="12" Foreground="#CBD5E1" Margin="0,8,0,12" TextWrapping="Wrap" />
                        <Button Grid.Row="2" Content="Запустить Лабораторную №1 ▶" Background="#0284C7" Foreground="White"
                                FontWeight="Bold" BorderThickness="0" Padding="14,8" HorizontalAlignment="Left"
                                Click="BtnOpenLab1_Click" />
                    </Grid>
                </Border>

                <!-- Карточка Лаб 2 -->
                <Border Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="16" Margin="6" Opacity="0.75">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="Лабораторная работа №2" FontSize="15" FontWeight="Bold" Foreground="#E2E8F0" />
                            <Border Background="#334155" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock Text="В разработке" FontSize="10" Foreground="#94A3B8" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Алгоритмы поиска данных и хеш-таблицы." FontSize="12" Foreground="#94A3B8" Margin="0,8,0,12" TextWrapping="Wrap" />
                        <Button Grid.Row="2" Content="Открыть" Background="#334155" Foreground="#94A3B8" BorderThickness="0" Padding="12,6" HorizontalAlignment="Left" Click="BtnPlaceholder_Click" Tag="2" />
                    </Grid>
                </Border>

                <!-- Карточка Лаб 3 -->
                <Border Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="16" Margin="6" Opacity="0.75">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="Лабораторная работа №3" FontSize="15" FontWeight="Bold" Foreground="#E2E8F0" />
                            <Border Background="#334155" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock Text="В разработке" FontSize="10" Foreground="#94A3B8" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Деревья поиска и графовые модели." FontSize="12" Foreground="#94A3B8" Margin="0,8,0,12" TextWrapping="Wrap" />
                        <Button Grid.Row="2" Content="Открыть" Background="#334155" Foreground="#94A3B8" BorderThickness="0" Padding="12,6" HorizontalAlignment="Left" Click="BtnPlaceholder_Click" Tag="3" />
                    </Grid>
                </Border>

                <!-- Карточка Лаб 4 (АКТИВНАЯ) -->
                <Border Background="#1E293B" CornerRadius="8" BorderBrush="#0284C7" BorderThickness="2" Padding="16" Margin="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="Лабораторная работа №4" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" />
                            <Border Background="#065F46" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock Text="ГОТОВА К РАБОТЕ" FontSize="10" FontWeight="Bold" Foreground="#6EE7B7" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Исследование алгоритмов сортировок (Пузырьковая, Шейкерная, Вставками, Быстрая, BOGO). Одновременная визуализация, импорт из Excel и Google Таблиц, замер времени t и итераций к/и."
                                   FontSize="12" Foreground="#CBD5E1" Margin="0,8,0,12" TextWrapping="Wrap" />
                        <Button Grid.Row="2" Content="Запустить Лабораторную №4 ▶" Background="#0284C7" Foreground="White"
                                FontWeight="Bold" BorderThickness="0" Padding="14,8" HorizontalAlignment="Left"
                                Click="BtnOpenLab4_Click" />
                    </Grid>
                </Border>
            </UniformGrid>
        </ScrollViewer>

        <!-- Подвал -->
        <Border Grid.Row="3" Margin="0,16,0,0" Padding="0,8,0,0" BorderBrush="#334155" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="C# WPF (.NET 10) • Лабораторная работа №4" FontSize="11" Foreground="#64748B" />
                <TextBlock Text="Отказоустойчивость • Одновременная визуализация" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
